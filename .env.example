# PaperTalkthrough settings.
# Copy this file to a new file named ".env" (no other name) and fill it in.
# Never share your .env file or upload it anywhere: it contains your API key.

# --- The AI you talk to -------------------------------------------------------
# Any OpenAI-compatible API works. Pick ONE provider and use its base URL:
#   OpenAI ............ https://api.openai.com/v1
#   Anthropic ......... https://api.anthropic.com/v1/
#   Google Gemini ..... https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter ........ https://openrouter.ai/api/v1
#   DeepSeek .......... https://api.deepseek.com/v1
#   A school/company AI gateway: use the base URL it gives you
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Which model to use. Run "check_gateway.py" to list the exact names your key can use.
# Choose a small, fast model: answers come back quicker and it costs less.
MODEL=gpt-4o-mini

# --- Reading voice (free, runs on your computer) -------------------------------
# af_heart, af_bella, af_nicole, am_adam, am_michael, bf_emma, bm_george, ...
VOICE=af_heart

# --- Web search for the AI -----------------------------------------------------
# on = the AI may look things up (free sources: DuckDuckGo, Wikipedia, OpenAlex papers)
WEB_SEARCH=on
# Optional, advanced: a model on your gateway that can use Google Search via a
# "google_search" tool (e.g. Gemini behind a Portkey gateway). Leave empty if unsure.
WEB_SEARCH_MODEL=

# --- Cost control --------------------------------------------------------------
# The AI sees the whole document if it's shorter than this many characters
# (about 4 characters per token). Lower it to spend less on long documents.
FULL_DOC_MAX_CHARS=400000
